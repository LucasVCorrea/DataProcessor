# Google Drive source folder. Share the folder with the service-account email as Reader.
BERISSO_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_PATH=/credentials/credentials.json
# Ruta del JSON en la máquina host, usada por docker-compose local.
GOOGLE_CREDENTIALS_HOST_PATH=
# Alternative for AWS: put the full service-account JSON in this env var via Secrets Manager.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local staging/output directory used by the Berisso DAG.
BERISSO_DATA_DIR=/data/berisso

# If configured, the DAG uploads the completed Parquet set here after a successful run.
BERISSO_S3_BUCKET=
BERISSO_S3_PREFIX=processed/berisso
AWS_REGION=us-east-1
