{
  "variable": {
    "TAG": {
      "default": "latest"
    }
  },

  "group": {
    "default": {
      "targets": ["airflow",
                  "airflow-google-worker"]
    }
  },

  "target": {
    "airflow": {
      "context": ".",
      "dockerfile": "Dockerfile",
      "target": "airflow_base",
      "tags": ["airDP/airflow:${TAG}",
               "airDP/airflow:latest"]
    },

    "airflow-google-worker": {
      "context": ".",
      "dockerfile": "Dockerfile",
      "target": "g-worker-base",
      "tags": ["airDP/google-worker:${TAG}",
               "airDP/google-worker:latest"]
    }
  }
}