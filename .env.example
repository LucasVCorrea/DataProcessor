# Google Drive source folder. Share the folder with the service-account email as Reader.
BERISSO_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_PATH=/credentials/credentials.json
# Ruta del JSON en la máquina host, usada por docker-compose local.
GOOGLE_CREDENTIALS_HOST_PATH=
# Alternative for AWS: put the full service-account JSON in this env var via Secrets Manager.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local staging/output directory used by the Berisso DAG.
BERISSO_DATA_DIR=/data/berisso

# If configured, the DAG uploads the completed Parquet set here after a successful run.
BERISSO_S3_BUCKET=
BERISSO_S3_PREFIX=processed/berisso
AWS_REGION=us-east-1

# Tessa / Tránsito. Reutiliza la misma cuenta de Google y, por defecto, el mismo bucket S3 de Berisso.
# El ID actual apunta directamente a data_files/tessa.
TESSA_DRIVE_FOLDER_ID=1w-r6aZAX5oGqyPjSHO1SMS4XunAbIFEu
TESSA_DRIVE_DATA_PATH=
TESSA_DATA_DIR=/data/transito
# Si se deja vacío, el DAG usa BERISSO_S3_BUCKET.
TESSA_S3_BUCKET=
TESSA_S3_PREFIX=processed/tessa

# Opcional: sobreescribir nombres si los Excel de Drive usan otros nombres.
TESSA_SOURCE_ACTIVIDAD_REVISORES=
TESSA_SOURCE_VALORES_UF=
TESSA_SOURCE_MOTIVOS_RECHAZOS=
TESSA_SOURCE_TIEMPO_REVISION=
TESSA_SOURCE_IMAGENES_PENDIENTES=
TESSA_SOURCE_REPORTES_CAMARAS=
TESSA_SOURCE_HISTORIAL_PENDIENTES=
